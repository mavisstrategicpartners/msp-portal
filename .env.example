# =========================================================
# MAVIS STRATEGIC PARTNERS (MSP) — PORTAL ENVIRONMENT VARIABLES
# =========================================================
# Copy to .env (local) or paste into your host's dashboard (Vercel / Netlify).
# No real secrets are stored in this file.

# --- BACKEND / DATABASE + AUTH (required) ------------------------------
# Client-side (safe to expose — publishable keys only)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side mirrors of the same values (used by server functions / SSR)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# Server-only. NEVER expose to the browser. Needed for admin actions
# (creating team members, granting admin roles).
SUPABASE_SERVICE_ROLE_KEY=

# --- OPTIONAL: TRANSACTIONAL EMAIL ------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@mavisstrategicpartners.co.za

# --- DEPLOYMENT -------------------------------------------------------
# Build target for the server bundle. Use "vercel" on Vercel,
# "netlify" on Netlify. Defaults to cloudflare if unset.
NITRO_PRESET=vercel

# --- GOHIGHLEVEL (GHL) CALENDAR & CRM INTEGRATION --------------------
# Server-only. Used to synchronize appointments and ingest webhooks from GoHighLevel.
GHL_API_KEY=
# or GHL_ACCESS_TOKEN for v2 OAuth/Private integration
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=
GHL_WEBHOOK_SECRET=

# --- APP META ---------------------------------------------------------
VITE_APP_NAME="Mavis Strategic Partners Portal"
VITE_APP_DOMAIN=mavisstrategicpartners.co.za
